# YT Helper API Environment Variables
# Copy or set these in your Render Web Service Environment Settings

# 1. Groq Cloud API Key (Required for LLM inference - Llama 3.3 70B, Llama 3.1 8B, etc.)
# Get a free key at https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here

# 2. Google Gemini API Key (Required for Gemini embedding models)
# Get a free key at https://aistudio.google.com/
GOOGLE_API_KEY=your_google_api_key_here

# 3. Render Keep-Alive URL (Highly Recommended on Render Free Tier)
# Prevents Render free instances from spinning down after 15 minutes of inactivity.
# Set this to your deployed Render URL: e.g. https://yt-helper-api.onrender.com
RENDER_EXTERNAL_URL=

# 4. CORS Allowed Origins (Optional, defaults to "*" to allow Vercel frontends)
# Example: https://yt-helper.vercel.app,http://localhost:3000
CORS_ORIGINS=*

# 5. Persistent ChromaDB Directory (Optional)
# If using a persistent disk on Render, point to mount path, e.g. /var/data/chroma_db
# Defaults to ./chroma_db
CHROMA_PERSIST_DIR=

# 6. YouTube Proxy (Optional)
# If YouTube blocks cloud datacenter IPs: e.g. http://username:password@proxyserver:port
YOUTUBE_PROXY=

# 7. Supadata YouTube Transcript API (Recommended for 100% reliable bypass on Render)
# Get a free key at https://supadata.ai
SUPADATA_API_KEY=
